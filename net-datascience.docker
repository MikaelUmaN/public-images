FROM mikaeluman/rust-datascience:latest

USER root

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
    DOTNET_GENERATE_ASPNETCORE_CERTIFICATE=0

# Install both .NET LTS SDKs side-by-side from Ubuntu repos (available since Ubuntu 24.04)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      dotnet-sdk-8.0 \
      dotnet-sdk-10.0; \
    dotnet --list-sdks

ENV PATH=/opt/devtools/dotnet:$PATH
RUN install -d -o $USER -g $USER /opt/devtools/dotnet "$HOME/.dotnet" && \
    ln -s /opt/devtools/dotnet "$HOME/.dotnet/tools"

USER $USER

# F# tools use a writable, account-independent tool directory.
ARG FANTOMAS_VERSION=7.0.6
ARG FSAUTOCOMPLETE_VERSION=0.84.0
ARG FSDOCS_VERSION=22.2.0
ARG FSHARPLINT_VERSION=0.27.0
RUN set -eux; \
    dotnet tool install --global fantomas --version "${FANTOMAS_VERSION}"; \
    dotnet tool install --global fsautocomplete --version "${FSAUTOCOMPLETE_VERSION}"; \
    dotnet tool install --global fsdocs-tool --version "${FSDOCS_VERSION}"; \
    dotnet tool install --global dotnet-fsharplint --version "${FSHARPLINT_VERSION}"; \
    fantomas --version; \
    fsautocomplete --version

LABEL org.opencontainers.image.dotnet.versions="8.0,10.0"

USER $USER
